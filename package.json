{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "test:ui": "vitest run",
        "typecheck": "tsc --noEmit",
        "test:e2e": "playwright test",
        "test:e2e:install": "playwright install chromium",
        "quality": "npm run format:check && npm run test:ui && npm run typecheck && npm run build",
        "check": "npm run typecheck && npm run build",
        "dev": "vite",
        "format": "prettier --write \"resources/js/**/*.{ts,tsx}\"",
        "format:check": "prettier --check \"resources/js/**/*.{ts,tsx}\""
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^24.13.3",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0",
        "vitest": "^3.2.7"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@ffmpeg/core": "0.12.10",
        "@ffmpeg/ffmpeg": "0.12.15",
        "@ffmpeg/util": "0.12.2",
        "@fontsource-variable/manrope": "^5.3.0",
        "@inertiajs/react": "^3.6.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "lucide-react": "^1.31.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "typescript": "^7.0.2"
    }
}
