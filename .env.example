APP_NAME="Padrão RD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=dev
HEALTH_CHECK_TOKEN=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Production can use LOG_CHANNEL=daily_json to keep structured JSON outside public_html.
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=900

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=45
OPENAI_INPUT_COST_MICROS_PER_TOKEN=0
OPENAI_OUTPUT_COST_MICROS_PER_TOKEN=0
# Modo efetivo e política de dados. A administração (/settings/ai) sobrepõe
# estes valores assim que a primeira configuração é salva.
AI_MODE=manual
AI_DATA_POLICY_APPROVED=false
# Autorização e tarifa da transcrição. Servem apenas como padrão inicial:
# depois de instalado, o controle fica em Administração → Inteligência artificial.
AI_AUDIO_VALIDATED=false
AI_AUDIO_PRICE_MICROS_PER_MINUTE=0
AI_AUDIO_PRICING_VERSION=manual-v1
AI_AUDIO_MAX_SECONDS=3600
AI_AUDIO_DIRECT_MAX_BYTES=25165824
AI_AUDIO_UPLOAD_MAX_BYTES=262144000
AI_AUDIO_CHUNK_MAX_KB=5120
AI_AUDIO_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
AI_AUDIO_HTTP_TIMEOUT=600
AI_CONTEXT_MODEL=gpt-5.6-luna
AI_CONTEXT_HTTP_TIMEOUT=120
AI_CONTEXT_PRICING_VERSION=settings-v1

# Odoo JSON-2. Keep disabled until the Odoo plan, model and custom idempotency field are validated.
ODOO_MODE=disabled
ODOO_BASE_URL=
ODOO_API_KEY=
ODOO_DATABASE=
ODOO_COST_MODEL=account.analytic.line
ODOO_ANALYTIC_ACCOUNT_ID=0
ODOO_COST_CURRENCY=USD
ODOO_IDEMPOTENCY_FIELD=x_padrao_rd_idempotency_key
ODOO_AMOUNT_MULTIPLIER=-1

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP da Hostinger. Com MAIL_MAILER=log nada chega a ninguém: a redefinição
# de senha e o envio de proposta ficam parados num arquivo. Use log apenas em
# desenvolvimento, sabendo disso. Confira com: php artisan padraord:mail-test
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="sistema@padraord.com.br"
MAIL_FROM_NAME="${APP_NAME}"
# Porta 465 usa TLS implícito (MAIL_SCHEME=smtps). Para 587, use MAIL_SCHEME=smtp,
# que negocia STARTTLS. O usuário é o endereço completo da caixa criada no hPanel.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
